# Kalakriti/Backend/.env.example
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# --- App ---
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Database (PostgreSQL 16) ---
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kalakriti

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=kalakriti-media
STORAGE_TIMEOUT_SECONDS=15.0

# --- Sarvam.ai (Primary STT + TTS) ---
# Sign up at sarvam.ai to get your API key
SARVAM_API_KEY=your-sarvam-api-key
SARVAM_STT_TIMEOUT_SECONDS=10.0
SARVAM_TTS_TIMEOUT_SECONDS=10.0

# --- Groq (LLM + Whisper STT fallback) ---
# Comma-separated keys for rotation during rate limits (30 req/min per key)
GROQ_API_KEYS=your-groq-api-key-1,your-groq-api-key-2
GROQ_TIMEOUT_SECONDS=15.0

# --- CORS ---
# Comma-separated origins. Add your ngrok URL during mobile testing.
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# --- Upload limits ---
MAX_IMAGE_UPLOAD_BYTES=3000000
MAX_AUDIO_UPLOAD_BYTES=10000000

# --- Pricing bounds (INR) ---
PRICING_MIN_INR=50
PRICING_MAX_INR=50000

# --- ONDC ---
ONDC_MOCK_MODE=true
ONDC_TIMEOUT_SECONDS=8.0

# --- Error tracking (optional) ---
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0